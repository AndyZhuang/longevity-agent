# ---------- Longevity-specific ----------
# local dev screenshots and QA artifacts
dev/screenshots
# agent run logs (kept in .gitignore so we don't accidentally commit an agent's
# private tool-call log)
runs/
*.log.jsonl
# scratch commit / tag / release note files (created by `git commit -F`, `git
# tag -F`, `gh release create --notes-file` on Windows where heredocs don't work
# in PowerShell). Delete or move to a real .md before committing.
.git-commit-msg.txt
.git-tag-msg.txt
.git-release-notes.txt

# ---------- Dependabot / Renovate ----------
.github/dependabot.yml
